<% layout('includes/boilerplate') -%>

<div class="container my-4">
    <!-- Back Button -->
    <a href="/admin/dashboard" class="btn btn-link text-decoration-none text-muted mb-3 p-0 fw-semibold d-inline-flex align-items-center gap-1">
        <span>⬅️</span> Back to Dashboard
    </a>
    
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold text-gradient-purple-blue mb-0">Class <%= className %> Absentees</h1>
            <p class="text-muted mb-0">Official absentee registry for today</p>
        </div>
    </div>

    <!-- IST Time and Date Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📅</span>
                <span class="fw-semibold text-secondary">Indian Standard Time (IST):</span>
            </div>
            <span class="fw-bold text-dark fs-5" id="current-time-ist">Loading date & time...</span>
        </div>
    </div>

    <!-- Submitter Teacher Info Banner -->
    <% if (absentRecords && absentRecords.length > 0) { %>
        <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <span class="fs-3">👤</span>
                <div>
                    <% if (absentRecords[0].submittedByAdmin) { %>
                        <span class="d-block small text-muted">Submitted By</span>
                        <span class="fw-bold text-dark">Admin (Management Console)</span>
                    <% } else if (absentRecords[0].teacher) { %>
                        <span class="d-block small text-muted">Submitted By Coordinator</span>
                        <span class="fw-bold text-dark"><%= absentRecords[0].teacher.name %> (Subject: <%= absentRecords[0].teacher.subject || 'N/A' %>)</span>
                    <% } else { %>
                        <span class="d-block small text-muted">Submitted By</span>
                        <span class="fw-bold text-dark">Staff Coordinator</span>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Absent Students Table -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass overflow-hidden">
        <div class="card-header bg-danger-subtle border-0 py-3 px-4">
            <h5 class="fw-bold text-danger mb-0 d-flex align-items-center gap-2">
                <span>⚠️</span> Today's Absentees (<%= absentRecords ? absentRecords.length : 0 %> Students)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 responsive-table">
                    <thead class="table-light text-secondary border-bottom">
                        <tr>
                            <th class="ps-4 py-3" style="width: 100px;">Roll No</th>
                            <th class="py-3">Student Name</th>
                            <th class="py-3">Parent Name</th>
                            <th class="pe-4 py-3">Parent Contact</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (absentRecords && absentRecords.length > 0) { %>
                            <% for (let record of absentRecords) { %>
                                <% if (record.student) { %>
                                    <tr class="transition-all">
                                        <td data-label="Roll No" class="ps-4 fw-semibold text-dark"><%= record.student.serialNo %></td>
                                        <td data-label="Student Name" class="fw-bold text-danger"><%= record.student.name %></td>
                                        <td data-label="Parent Name" class="text-secondary"><%= record.student.parentName %></td>
                                        <td data-label="Parent Contact" class="pe-4 fw-medium text-muted phone-cell">
                                            📞 <%= record.student.parentMobile %>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5 text-success">
                                    <span class="fs-1 d-block mb-3">🎉</span>
                                    <span class="fw-bold fs-5">No students are absent today!</span>
                                    <p class="text-muted mb-0 small mt-1">Perfect attendance has been logged for this class standard.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Send WhatsApp Notifications Section -->
    <% if (absentRecords && absentRecords.length > 0) { %>
        <form action="/admin/attendance/class/<%= className %>/send-whatsapp" method="POST" class="d-flex justify-content-end mt-4" onsubmit="const btn = this.querySelector('button[type=submit]'); btn.disabled = true; btn.innerHTML = '💬 Sending...';">
            <button type="submit" class="btn btn-lg rounded-pill fw-bold shadow-sm px-5 py-3 border-0 text-white transition-all" style="background-color: #25D366;" id="whatsapp-send-btn">
                💬 Send WhatsApp Notification to Parents
            </button>
        </form>
    <% } %>
</div>

<style>
    #whatsapp-send-btn {
        transition: all 0.25s ease-in-out;
    }
    #whatsapp-send-btn:hover {
        background-color: #128C7E !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3) !important;
    }
</style>

<script>
    // Live ticking clock in IST timezone
    function updateClock() {
        const options = {
            timeZone: 'Asia/Kolkata',
            hour12: true,
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const formatter = new Intl.DateTimeFormat('en-IN', options);
        const clockEl = document.getElementById('current-time-ist');
        if (clockEl) {
            clockEl.textContent = formatter.format(new Date());
        }
    }
    updateClock();
    setInterval(updateClock, 1000);
</script>
