<% layout('includes/boilerplate') -%>

<div class="container my-4">
    <!-- Back Button -->
    <a href="/students" class="btn btn-link text-decoration-none text-muted mb-3 p-0 fw-semibold d-inline-flex align-items-center gap-1">
        <span>⬅️</span> Back to Class Selector
    </a>
    
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold text-gradient-purple-blue mb-0">Class <%= className %> Registry</h1>
            <p class="text-muted mb-0">Manage student records for the active <%= className %> standard section</p>
        </div>
        <% if (isAdmin) { %>
        <div class="d-flex gap-2">
            <a href="/students/class/<%= className %>/new" class="btn btn-primary px-4 py-2.5 rounded-pill fw-bold btn-gradient-blue shadow transition-all">
                <span class="me-1">➕</span> Add New Student
            </a>
            <button type="button" class="btn btn-outline-primary px-4 py-2.5 rounded-pill fw-bold transition-all shadow-sm" data-bs-toggle="modal" data-bs-target="#manageFeesModal">
                💰 Fees Section
            </button>
        </div>
        <% } %>
    </div>

    <!-- IST Time and Date Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📅</span>
                <span class="fw-semibold text-secondary">Indian Standard Time (IST):</span>
            </div>
            <span class="fw-bold text-dark fs-5" id="current-time-ist">Loading date & time...</span>
        </div>
    </div>

    <!-- Table Container Card with Glassmorphism -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 responsive-table">
                    <thead class="table-light text-secondary border-bottom">
                        <tr>
                            <th class="ps-4 py-3">S.No.</th>
                            <th class="py-3">Presentee</th>
                            <th class="py-3">Name</th>
                            <th class="py-3">Class</th>
                            <th class="py-3">Parent Name</th>
                            <th class="py-3">Parent Mobile</th>
                            <th class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (students && students.length > 0) { %>
                            <% for (let student of students) { %>
                                <tr class="transition-all">
                                    <td data-label="S.No." class="ps-4 fw-semibold text-dark"><%= student.serialNo %></td>
                                    <td data-label="Presentee">
                                        <div class="form-check form-switch m-0 d-inline-block">
                                            <input class="form-check-input attendance-toggle transition-all" type="checkbox" role="switch" id="switch-<%= student._id %>" data-id="<%= student._id %>" <%= student.status === 'Present' ? 'checked' : '' %> style="cursor: pointer; width: 2.2em; height: 1.1em;">
                                            <label class="form-check-label ms-2 small fw-bold <%= student.status === 'Present' ? 'text-success' : 'text-muted' %>" id="label-<%= student._id %>" for="switch-<%= student._id %>" style="min-width: 50px;">
                                                <%= student.status || 'Absent' %>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="Name" class="fw-semibold text-dark"><%= student.name %></td>
                                    <td data-label="Class">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1.5 fw-semibold"><%= student.className %></span>
                                    </td>
                                    <td data-label="Parent Name"><%= student.parentName %></td>
                                    <td data-label="Parent Mobile" class="phone-cell">
                                        <a href="tel:<%= student.parentMobile %>" class="text-decoration-none text-muted small fw-medium">
                                            📞 <%= student.parentMobile %>
                                        </a>
                                    </td>
                                    <td data-label="Actions" class="pe-4 text-end">
                                        <div class="d-flex justify-content-end gap-2 responsive-actions">
                                            <a href="/students/<%= student._id %>/history" class="btn btn-sm btn-outline-dark px-3 rounded-pill transition-all fw-semibold">
                                                📊 History
                                            </a>
                                            <% if (isAdmin) { %>
                                            <button type="button" class="btn btn-sm btn-outline-primary px-3 rounded-pill transition-all fw-semibold" data-bs-toggle="modal" data-bs-target="#feesModal-<%= student._id %>">
                                                💰 Fees
                                            </button>
                                            <a href="/students/<%= student._id %>/edit" class="btn btn-sm btn-outline-secondary px-3 rounded-pill transition-all fw-semibold">
                                                ✏️ Edit
                                            </a>
                                            <form action="/students/<%= student._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded-pill transition-all fw-semibold">
                                                    🗑️ Delete
                                                </button>
                                            </form>
                                            <% } else { %>
                                            <a href="/students/<%= student._id %>" class="btn btn-sm btn-outline-primary px-3 rounded-pill transition-all fw-semibold">
                                                👁️ View
                                            </a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <span class="fs-1 d-block mb-3">📁</span>
                                    <span class="fw-semibold">No students registered yet.</span>
                                    <% if (isAdmin) { %>
                                    <a href="/students/new" class="d-block mt-2 text-primary fw-bold text-decoration-none small">Add the first student now</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Submit Attendance Section -->
    <div class="d-flex justify-content-end mt-4">
        <a href="/students/class/<%= className %>/attendance-summary" class="btn btn-lg btn-gradient-blue rounded-pill fw-bold shadow-sm px-5 py-3 border-0 transition-all text-center">
            📊 Review & Submit Attendance
        </a>
    </div>
</div>

<% if (isAdmin) { %>
    <!-- Individual Fees Modals -->
    <% for (let student of students) { %>
        <div class="modal fade" id="feesModal-<%= student._id %>" tabindex="-1" aria-labelledby="feesModalLabel-<%= student._id %>" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title fw-bold text-dark" id="feesModalLabel-<%= student._id %>">💰 Student Fees Structure</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/students/<%= student._id %>/fees?_method=PUT" method="POST" class="needs-validation" novalidate>
                        <div class="modal-body py-3">
                            <div class="mb-3 text-center">
                                <h4 class="fw-bold text-gradient-purple-blue mb-1"><%= student.name %></h4>
                                <p class="text-muted small">Class <%= student.className %> - Serial No. <%= student.serialNo %></p>
                            </div>
                            
                            <!-- Total Fee -->
                            <div class="mb-3">
                                <label for="totalFee-<%= student._id %>" class="form-label fw-semibold">Total Fee (Rs.)</label>
                                <input type="number" class="form-control rounded-3" id="totalFee-<%= student._id %>" name="student[totalFee]" value="<%= student.totalFee || 0 %>" min="0" oninput="calculatePending('<%= student._id %>')" required>
                            </div>

                            <!-- Previously Paid Fee -->
                            <div class="mb-3">
                                <label for="prevReceivedFee-<%= student._id %>" class="form-label fw-semibold text-muted">Previously Paid Fee (Rs.)</label>
                                <input type="number" class="form-control rounded-3 bg-light text-muted" id="prevReceivedFee-<%= student._id %>" value="<%= student.receivedFee || 0 %>" readonly>
                            </div>

                            <!-- Pay Installment -->
                            <div class="mb-3">
                                <label for="currentPayment-<%= student._id %>" class="form-label fw-semibold text-success">Pay Installment / Current Paid Amount (Rs.)</label>
                                <input type="number" class="form-control rounded-3 border-success text-success fw-semibold" id="currentPayment-<%= student._id %>" name="student[currentPayment]" value="0" oninput="calculatePending('<%= student._id %>')" required>
                            </div>

                            <!-- Pending Fee -->
                            <div class="mb-3">
                                <label for="pendingFee-<%= student._id %>" class="form-label fw-semibold text-danger">Pending Fee (Rs.)</label>
                                <input type="number" class="form-control rounded-3 bg-light text-danger fw-bold" id="pendingFee-<%= student._id %>" name="student[pendingFee]" value="<%= student.pendingFee || 0 %>" readonly>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0">
                            <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold btn-gradient-blue border-0">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Manage Class Fees Modal -->
    <div class="modal fade" id="manageFeesModal" tabindex="-1" aria-labelledby="manageFeesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold text-dark" id="manageFeesModalLabel">💰 Class <%= className %> Fees Section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary border-bottom">
                                <tr>
                                    <th>S.No.</th>
                                    <th>Student Name</th>
                                    <th>Total Fee (Rs.)</th>
                                    <th>Received Fee (Rs.)</th>
                                    <th class="text-danger">Pending Fee (Rs.)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length > 0) { %>
                                    <% for (let student of students) { %>
                                        <tr>
                                            <td class="fw-semibold text-dark"><%= student.serialNo %></td>
                                            <td class="fw-semibold text-dark"><%= student.name %></td>
                                            <td>Rs. <%= student.totalFee || 0 %></td>
                                            <td class="text-success fw-medium">Rs. <%= student.receivedFee || 0 %></td>
                                            <td class="text-danger fw-bold">Rs. <%= student.pendingFee || 0 %></td>
                                        </tr>
                                    <% } %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No students in registry to display.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    
                    <% if (students && students.some(s => s.pendingFee > 0)) { %>
                        <hr class="my-4 text-secondary opacity-25">
                        
                        <!-- Send WhatsApp Notification Section -->
                        <div class="p-3 bg-light rounded-3 text-center">
                            <h6 class="fw-bold text-dark mb-2">📢 Send WhatsApp Fee Reminders</h6>
                            <p class="small text-muted mb-3">Send WhatsApp reminders to all parents of students with pending fees for Class <%= className %>.</p>
                            <form action="/students/class/<%= className %>/fees/notify" method="POST" onsubmit="return confirm('Are you sure you want to send WhatsApp fee notifications to all parents with pending fees?');">
                                <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold btn-gradient-blue border-0 shadow transition-all">
                                    💬 Send WhatsApp Notifications
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
<% } %>

<script>
    function calculatePending(studentId) {
        const totalInput = document.getElementById(`totalFee-${studentId}`);
        const prevReceivedInput = document.getElementById(`prevReceivedFee-${studentId}`);
        const currentPaymentInput = document.getElementById(`currentPayment-${studentId}`);
        const pendingInput = document.getElementById(`pendingFee-${studentId}`);
        if (totalInput && prevReceivedInput && currentPaymentInput && pendingInput) {
            const total = parseFloat(totalInput.value) || 0;
            const prevReceived = parseFloat(prevReceivedInput.value) || 0;
            const currentPayment = parseFloat(currentPaymentInput.value) || 0;
            pendingInput.value = Math.max(0, total - (prevReceived + currentPayment));
        }
    }
</script>

<script>
    // Live ticking clock in IST timezone
    function updateClock() {
        const options = {
            timeZone: 'Asia/Kolkata',
            hour12: true,
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const formatter = new Intl.DateTimeFormat('en-IN', options);
        const clockEl = document.getElementById('current-time-ist');
        if (clockEl) {
            clockEl.textContent = formatter.format(new Date());
        }
    }
    updateClock();
    setInterval(updateClock, 1000);

    document.querySelectorAll('.attendance-toggle').forEach(toggle => {
        toggle.addEventListener('change', async (e) => {
            const studentId = e.target.getAttribute('data-id');
            const status = e.target.checked ? 'Present' : 'Absent';
            const label = document.getElementById(`label-${studentId}`);
            
            // Disable during network request
            e.target.disabled = true;
            
            try {
                const response = await fetch(`/students/${studentId}/attendance`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status })
                });
                
                if (response.ok) {
                    const data = await response.json();
                    label.textContent = data.status;
                    if (data.status === 'Present') {
                        label.className = 'form-check-label ms-2 small fw-bold text-success';
                    } else {
                        label.className = 'form-check-label ms-2 small fw-bold text-muted';
                    }
                } else {
                    e.target.checked = !e.target.checked;
                    alert('Error updating attendance. Please try again.');
                }
            } catch (err) {
                e.target.checked = !e.target.checked;
                alert('Connection error. Could not update attendance.');
            } finally {
                e.target.disabled = false;
            }
        });
    });
</script>
