<% layout('includes/boilerplate') -%>

<div class="container my-4">
    <!-- Back Button -->
    <a href="/students/<%= student._id %>/history/months?subject=<%= encodeURIComponent(subject) %>" class="btn btn-link text-decoration-none text-muted mb-3 p-0 fw-semibold d-inline-flex align-items-center gap-1">
        <span>⬅️</span> Back to Month Selector
    </a>
    
    <% 
    const monthNames = [
        'January', 'February', 'March', 'April', 'May', 'June', 
        'July', 'August', 'September', 'October', 'November', 'December'
    ];
    const monthName = monthNames[month];
    %>

    <!-- Student Header Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: 700;">
                    <%= student.name.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-0"><%= student.name %></h2>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-bold mt-1">Class <%= student.className %></span>
                </div>
            </div>
            <div class="text-sm-end">
                <span class="d-block small text-muted">Active Calendar Month</span>
                <span class="badge bg-dark rounded-pill px-3 py-1.5 fw-bold mt-1">
                    <%= monthName %> <%= year %>
                </span>
            </div>
        </div>
    </div>

    <!-- IST Time and Date Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📅</span>
                <span class="fw-semibold text-secondary">Indian Standard Time (IST):</span>
            </div>
            <span class="fw-bold text-dark fs-5" id="current-time-ist">Loading date & time...</span>
        </div>
    </div>

    <% if (subject === 'all') { %>
        <div class="alert alert-warning border-0 rounded-4 shadow-sm bg-warning-subtle text-warning-emphasis p-3 mb-4 d-flex align-items-center gap-3">
            <span class="fs-4">⚠️</span>
            <div>
                <strong class="fw-bold d-block">Overall Attendance Log Only</strong>
                <span class="small text-secondary">This detailed view shows cumulative records across all classes. Subject and coordinator names are omitted in the overall log.</span>
            </div>
        </div>
    <% } %>

    <!-- Monthly Statistics Dashboard -->
    <div class="row g-4 mb-4 justify-content-center">
        <!-- Days Present -->
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-4 text-center hero-card h-100">
                <span class="fs-1 mb-2">✅</span>
                <div class="text-muted small fw-medium text-uppercase tracking-wider">Days Present</div>
                <h3 class="fw-extrabold text-success mb-0 mt-1"><%= presentDays %> / <%= totalSessions %></h3>
                <span class="small text-muted mt-2 d-block">Presents out of total logged sessions</span>
            </div>
        </div>
        <!-- Days Absent -->
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-4 text-center hero-card h-100">
                <span class="fs-1 mb-2">🚨</span>
                <div class="text-muted small fw-medium text-uppercase tracking-wider">Days Absent</div>
                <h3 class="fw-extrabold text-danger mb-0 mt-1"><%= absentDays %> / <%= totalSessions %></h3>
                <span class="small text-muted mt-2 d-block">Absences out of total logged sessions</span>
            </div>
        </div>
    </div>

    <!-- Attendance Details Table -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass overflow-hidden">
        <div class="card-header bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <span>📋</span> Attendance Log Directory
            </h5>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 fw-bold small">
                Scope: <%= subject !== 'all' ? `Subject - ${subject}` : 'All Subjects' %>
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary border-bottom">
                        <tr>
                            <th class="ps-4 py-3">Date & Time (IST)</th>
                            <% if (subject !== 'all') { %>
                                <th class="py-3">Subject</th>
                                <th class="py-3">Coordinator</th>
                            <% } %>
                            <th class="pe-4 py-3 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (records && records.length > 0) { %>
                            <% for (let record of records) { 
                                const dateOptions = { 
                                    timeZone: 'Asia/Kolkata', 
                                    year: 'numeric', 
                                    month: 'short', 
                                    day: '2-digit', 
                                    hour: '2-digit', 
                                    minute: '2-digit', 
                                    hour12: true 
                                };
                                const formattedDate = new Intl.DateTimeFormat('en-IN', dateOptions).format(record.date);
                            %>
                                <tr class="transition-all">
                                    <td class="ps-4 fw-semibold text-dark"><%= formattedDate %></td>
                                    <% if (subject !== 'all') { %>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 fw-semibold small">
                                                <%= record.submittedByAdmin ? 'General' : ((record.teacher && record.teacher.subject) || 'N/A') %>
                                            </span>
                                        </td>
                                        <td class="text-secondary">
                                            <%= record.submittedByAdmin ? 'Admin' : ((record.teacher && record.teacher.name) || 'Unknown') %>
                                        </td>
                                    <% } %>
                                    <td class="pe-4 text-end">
                                        <% if (record.status === 'Present') { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold small">Present</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold small">Absent</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        <% } else { %>
                            <tr>
                                <td colspan="<%= subject !== 'all' ? 4 : 2 %>" class="text-center py-5 text-muted">
                                    <span class="fs-1 d-block mb-3">📂</span>
                                    <span class="fw-semibold">No attendance sessions recorded for this month yet.</span>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Live ticking clock in IST timezone
    function updateClock() {
        const options = {
            timeZone: 'Asia/Kolkata',
            hour12: true,
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const formatter = new Intl.DateTimeFormat('en-IN', options);
        const clockEl = document.getElementById('current-time-ist');
        if (clockEl) {
            clockEl.textContent = formatter.format(new Date());
        }
    }
    updateClock();
    setInterval(updateClock, 1000);
</script>
