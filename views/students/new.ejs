<% layout('includes/boilerplate') -%>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <a href="/students/class/<%= className %>" class="btn btn-link text-decoration-none text-muted mb-4 p-0 fw-semibold d-inline-flex align-items-center gap-1">
                <span>⬅️</span> Back to <%= className %> Class Registry
            </a>
            
            <div class="card border-0 rounded-4 shadow-lg bg-white-glass p-4 p-md-5">
                <h2 class="fw-bold text-gradient-purple-blue mb-2 text-center">Add New Student</h2>
                <p class="text-center text-muted mb-4">Registering student for Class <strong><%= className %></strong></p>
                
                <form action="/students/class/<%= className %>" method="POST" class="needs-validation" novalidate>
                    <!-- Student Name -->
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">Student Name</label>
                        <input type="text" class="form-control rounded-3" id="name" name="student[name]" placeholder="e.g. John Doe" required>
                        <div class="invalid-feedback">Please enter the student's name.</div>
                    </div>
                    
                    <!-- Parent Name -->
                    <div class="mb-3">
                        <label for="parentName" class="form-label fw-semibold">Parent / Guardian Name</label>
                        <input type="text" class="form-control rounded-3" id="parentName" name="student[parentName]" placeholder="e.g. Richard Doe" required>
                        <div class="invalid-feedback">Please enter parent/guardian's name.</div>
                    </div>
                    
                    <!-- Parent Mobile -->
                    <div class="mb-3">
                        <label for="parentMobile" class="form-label fw-semibold">Parent Mobile Number</label>
                        <input type="tel" class="form-control rounded-3" id="parentMobile" name="student[parentMobile]" placeholder="e.g. 9876543210" pattern="[0-9]{10}" required>
                        <div class="invalid-feedback">Please enter a valid 10-digit mobile number.</div>
                    </div>

                    <!-- Total Fee -->
                    <div class="mb-3">
                        <label for="totalFee" class="form-label fw-semibold">Total Fee (Rs.)</label>
                        <input type="number" class="form-control rounded-3" id="totalFee" name="student[totalFee]" placeholder="e.g. 5000" min="0" required>
                        <div class="invalid-feedback">Please enter the total fee.</div>
                    </div>

                    <!-- Received Fee -->
                    <div class="mb-4">
                        <label for="receivedFee" class="form-label fw-semibold">Received Fee (Rs.)</label>
                        <input type="number" class="form-control rounded-3" id="receivedFee" name="student[receivedFee]" placeholder="e.g. 0" min="0" required>
                        <div class="invalid-feedback">Please enter the received fee.</div>
                    </div>
                    
                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold w-100 btn-gradient-blue shadow transition-all py-3 border-0">
                        💾 Register Student
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Bootstrap validation script
    (() => {
      'use strict'
      const forms = document.querySelectorAll('.needs-validation')
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          }
          form.classList.add('was-validated')
        }, false)
      })
    })()
</script>
