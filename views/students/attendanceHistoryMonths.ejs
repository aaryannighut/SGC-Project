<% layout('includes/boilerplate') -%>

<style>
    @media (max-width: 576px) {
        .table-responsive table.custom-payment-table {
            min-width: 0px !important;
            table-layout: fixed !important;
            width: 270px !important;
        }
        .table-responsive table.custom-payment-table th, 
        .table-responsive table.custom-payment-table td {
            padding: 6px 2px !important;
            font-size: 0.74rem !important;
            word-wrap: break-word !important;
            white-space: normal !important;
        }
        .table-responsive table.custom-payment-table th:first-child,
        .table-responsive table.custom-payment-table td:first-child {
            width: 35px !important;
            padding-left: 2px !important;
        }
        .table-responsive table.custom-payment-table th:nth-child(2),
        .table-responsive table.custom-payment-table td:nth-child(2) {
            width: 100px !important;
        }
        .table-responsive table.custom-payment-table th:nth-child(3),
        .table-responsive table.custom-payment-table td:nth-child(3) {
            width: 135px !important;
            padding-right: 2px !important;
        }
    }
</style>

<div class="container my-4">
    <!-- Back Button -->
    <a href="/students/class/<%= student.className %>" class="btn btn-link text-decoration-none text-muted mb-3 p-0 fw-semibold d-inline-flex align-items-center gap-1">
        <span>⬅️</span> Back to Class Registry
    </a>
    
    <!-- Student Header Summary Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: 700;">
                    <%= student.name.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-0"><%= student.name %></h2>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-bold mt-1">Class <%= student.className %></span>
                </div>
            </div>
            <div class="text-sm-end">
                <span class="d-block small text-muted">Attendance Scope</span>
                <span class="badge bg-dark rounded-pill px-3 py-1.5 fw-bold mt-1">
                    <%= subject !== 'all' ? `Subject: ${subject}` : 'Overall Attendance' %>
                </span>
            </div>
        </div>
    </div>

    <!-- IST Time and Date Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📅</span>
                <span class="fw-semibold text-secondary">Indian Standard Time (IST):</span>
            </div>
            <span class="fw-bold text-dark fs-5" id="current-time-ist">Loading date & time...</span>
        </div>
    </div>



    <% if (isAdmin) { %>
        <!-- Fees & Payment History Section -->
        <div class="mt-4 mb-4">
            <h4 class="fw-bold text-dark mb-1">💰 Fees & Payment History</h4>
            <p class="text-muted mb-0">Review the student's fee structure details and chronological installment history.</p>
        </div>

        <div class="row g-4 mb-5">
            <!-- Summary Column -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 bg-white-glass rounded-4 shadow-sm p-4 h-100">
                    <h5 class="fw-bold text-dark mb-4">Fee Structure Summary</h5>
                    
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light">
                        <span class="text-muted small fw-semibold">Total Fee</span>
                        <span class="fw-bold text-dark fs-5">Rs. <%= student.totalFee || 0 %></span>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light">
                        <span class="text-muted small fw-semibold">Total Received (Paid)</span>
                        <span class="fw-bold text-success fs-5">Rs. <%= student.receivedFee || 0 %></span>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-muted small fw-semibold">Pending Fee</span>
                        <span class="fw-bold text-danger fs-5">Rs. <%= student.pendingFee || 0 %></span>
                    </div>

                    <!-- Progress Bar -->
                    <% 
                    const percentPaid = student.totalFee > 0 ? Math.min(100, Math.round((student.receivedFee / student.totalFee) * 100)) : 0; 
                    %>
                    <div class="mt-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted fw-semibold">Payment Progress</span>
                            <span class="small fw-bold text-primary"><%= percentPaid %>%</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 10px;">
                            <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: <%= percentPaid %>%;" aria-valuenow="<%= percentPaid %>" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Installment Timeline Column -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 bg-white-glass rounded-4 shadow-sm p-4 h-100">
                    <h5 class="fw-bold text-dark mb-4">Chronological Installments Log</h5>
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-payment-table">
                            <thead class="table-light text-secondary border-bottom">
                                <tr>
                                    <th class="py-2">S.No.</th>
                                    <th class="py-2">Installment Paid</th>
                                    <th class="py-2">Date & Time (IST)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (student.paymentHistory && student.paymentHistory.length > 0) { %>
                                    <% 
                                    const reversedHistory = [...student.paymentHistory].reverse();
                                    reversedHistory.forEach((payment, index) => {
                                        const dateOptions = { 
                                            timeZone: 'Asia/Kolkata', 
                                            year: 'numeric', 
                                            month: 'short', 
                                            day: '2-digit', 
                                            hour: '2-digit', 
                                            minute: '2-digit', 
                                            hour12: true 
                                        };
                                        const formattedDate = new Intl.DateTimeFormat('en-IN', dateOptions).format(payment.date);
                                    %>
                                        <tr>
                                            <td class="fw-semibold text-secondary"><%= reversedHistory.length - index %></td>
                                            <td class="fw-bold text-success">Rs. <%= payment.amount %></td>
                                            <td class="text-dark small fw-medium"><%= formattedDate %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="text-center py-5 text-muted">
                                            <span class="fs-1 d-block mb-2">💸</span>
                                            <span class="fw-semibold small">No individual payment installments logged yet.</span>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Month Selection Header -->
    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-1">📅 Academic Calendar Year: <%= currentYear %></h4>
        <p class="text-muted mb-0">Select any month below to view the detailed student attendance log and stats.</p>
    </div>

    <!-- 12-Month Cards Grid -->
    <div class="row g-3">
        <% 
        const monthNames = [
            'January', 'February', 'March', 'April', 'May', 'June', 
            'July', 'August', 'September', 'October', 'November', 'December'
        ];
        for (let i = 0; i < 12; i++) {
            const absences = monthAbsences[i];
            let badgeClass = 'bg-success-subtle text-success border-success-subtle';
            if (absences > 0 && absences <= 2) {
                badgeClass = 'bg-warning-subtle text-warning border-warning-subtle';
            } else if (absences > 2) {
                badgeClass = 'bg-danger-subtle text-danger border-danger-subtle';
            }
        %>
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card border-0 bg-white-glass rounded-4 shadow-sm p-3 h-100 d-flex flex-column justify-content-between transition-all hero-card">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><%= monthNames[i] %></h5>
                            <span class="badge border <%= badgeClass %> rounded-pill px-2.5 py-1 fw-bold small">
                                <%= absences %> Absent
                            </span>
                        </div>
                        <p class="small text-muted mb-0">
                            <%= absences === 0 ? 'Perfect record maintained.' : `Absence logged on ${absences} session day${absences > 1 ? 's' : ''}.` %>
                        </p>
                    </div>
                    <div class="mt-4">
                        <a href="/students/<%= student._id %>/history/<%= currentYear %>/<%= i %>?subject=<%= encodeURIComponent(subject) %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold transition-all w-100 text-center">
                            View Details ➔
                        </a>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>

<script>
    // Live ticking clock in IST timezone
    function updateClock() {
        const options = {
            timeZone: 'Asia/Kolkata',
            hour12: true,
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const formatter = new Intl.DateTimeFormat('en-IN', options);
        const clockEl = document.getElementById('current-time-ist');
        if (clockEl) {
            clockEl.textContent = formatter.format(new Date());
        }
    }
    updateClock();
    setInterval(updateClock, 1000);
</script>
