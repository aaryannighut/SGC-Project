<% layout('includes/boilerplate') -%>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <!-- Back Button -->
            <a href="/students" class="btn btn-link text-decoration-none text-muted mb-4 p-0 fw-semibold d-inline-flex align-items-center gap-1">
                <span>⬅️</span> Back to Registry
            </a>
            
            <!-- Student Detail Card -->
            <div class="card border-0 rounded-4 shadow-lg bg-white-glass overflow-hidden hero-card">
                <!-- Header Accent with Navy Gradient -->
                <div class="bg-gradient-nav p-5 text-center text-white position-relative">
                    <div class="avatar-placeholder bg-white text-dark rounded-circle mx-auto d-flex align-items-center justify-content-center shadow mb-3" style="width: 80px; height: 80px; font-size: 2.25rem; font-weight: 700;">
                        <%= student.name.charAt(0).toUpperCase() %>
                    </div>
                    <h2 class="fw-bold mb-1"><%= student.name %></h2>
                    <span class="badge bg-white text-dark rounded-pill px-3 py-1.5 fw-semibold small shadow-sm">Roll No: <%= student.rollNo %></span>
                </div>
                
                <!-- Card Body -->
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-6 border-end text-center">
                            <div class="p-2">
                                <span class="d-block small text-muted text-uppercase tracking-wider fw-medium mb-1">Class</span>
                                <h4 class="fw-bold text-gradient-purple-blue m-0"><%= student.className %></h4>
                            </div>
                        </div>
                        <div class="col-6 text-center">
                            <div class="p-2">
                                <span class="d-block small text-muted text-uppercase tracking-wider fw-medium mb-1">Registered On</span>
                                <h6 class="fw-bold text-dark m-0 mt-1"><%= new Date(student.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></h6>
                            </div>
                        </div>
                        
                        <div class="col-12 border-top pt-4">
                            <h5 class="fw-bold text-dark mb-3">Parent Information</h5>
                            
                            <div class="d-flex flex-column gap-3">
                                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 transition-all hover-translate-x">
                                    <span class="fs-4">👤</span>
                                    <div>
                                        <span class="d-block small text-muted">Parent Name</span>
                                        <span class="fw-semibold text-dark"><%= student.parentName %></span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 transition-all hover-translate-x">
                                    <span class="fs-4">📞</span>
                                    <div>
                                        <span class="d-block small text-muted">Parent Mobile</span>
                                        <a href="tel:<%= student.parentMobile %>" class="text-decoration-none fw-semibold text-primary">
                                            <%= student.parentMobile %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Actions Footer -->
                <div class="card-footer bg-light border-0 p-4 d-flex justify-content-between gap-3">
                    <a href="/students/<%= student._id %>/edit" class="btn btn-outline-primary px-4 py-2.5 rounded-pill fw-bold w-100 transition-all text-center">
                        ✏️ Edit Details
                    </a>
                    
                    <form action="/students/<%= student._id %>?_method=DELETE" method="POST" class="w-100" onsubmit="return confirm('Are you sure you want to delete this student?');">
                        <button type="submit" class="btn btn-outline-danger px-4 py-2.5 rounded-pill fw-bold w-100 transition-all">
                            🗑️ Delete Profile
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
