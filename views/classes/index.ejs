<% layout('includes/boilerplate') -%>

<div class="container my-4">
    <!-- Header Section -->
    <div class="mb-4">
        <h1 class="display-5 fw-bold text-gradient-purple-blue mb-0">Classes & Scheduling</h1>
        <p class="text-muted">Manage active classes and academic coordinators</p>
    </div>

    <div class="row g-4">
        <!-- Classes Grid Panel (Left/Main Column) -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-4 h-100">
                <h4 class="fw-bold text-dark mb-4">Active Classes</h4>
                
                <% if (classes && classes.length > 0) { %>
                    <div class="row g-3">
                        <% for (let classItem of classes) { %>
                            <div class="col-12 col-md-6">
                                <div class="card rounded-3 border-0 bg-light p-3 position-relative transition-all hero-card">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1.5 fw-bold fs-6 mb-2">
                                                <%= classItem.className %>
                                            </span>
                                            <div class="mt-2 text-muted small fw-medium">Assigned Teacher</div>
                                            <div class="fw-bold text-dark fs-5 mt-1">
                                                <% if (classItem.assignedTeacher) { %>
                                                    👨‍🏫 <%= classItem.assignedTeacher.name %>
                                                <% } else { %>
                                                    <span class="text-warning">⚠️ Unassigned</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <hr class="my-3 text-secondary opacity-25">
                                    
                                    <div class="d-flex gap-2 justify-content-end">
                                        <!-- Edit Modal Trigger -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary px-3 rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#editClassModal-<%= classItem._id %>">
                                            ✏️ Edit
                                        </button>
                                        
                                        <!-- Delete Form -->
                                        <form action="/classes/<%= classItem._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this class?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded-pill fw-semibold">
                                                🗑️ Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5 text-muted">
                        <span class="fs-1 d-block mb-3">🏫</span>
                        <span class="fw-semibold">No classes added yet.</span>
                        <p class="small">Create one using the form on the right.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Add Class Form (Right Column) -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm bg-white-glass p-4">
                <h4 class="fw-bold text-dark mb-4">Create Class</h4>
                
                <form action="/classes" method="POST" class="needs-validation" novalidate>
                    <!-- Class Selection -->
                    <div class="mb-3">
                        <label for="newClassName" class="form-label fw-semibold">Class Standard</label>
                        <select class="form-select rounded-3" id="newClassName" name="class[className]" required>
                            <option value="" disabled selected>Select class standard...</option>
                            <option value="5th">5th</option>
                            <option value="6th">6th</option>
                            <option value="7th">7th</option>
                            <option value="8th">8th</option>
                            <option value="9th">9th</option>
                            <option value="10th">10th</option>
                        </select>
                        <div class="invalid-feedback">Please select a class standard.</div>
                    </div>
                    
                    <!-- Teacher Selection -->
                    <div class="mb-4">
                        <label for="newAssignedTeacher" class="form-label fw-semibold">Assign Teacher (Optional)</label>
                        <select class="form-select rounded-3" id="newAssignedTeacher" name="class[assignedTeacher]">
                            <option value="">No Teacher Assigned</option>
                            <% for (let teacher of teachers) { %>
                                <option value="<%= teacher._id %>"><%= teacher.name %></option>
                            <% } %>
                        </select>
                    </div>
                    
                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary rounded-pill fw-bold w-100 btn-gradient-blue shadow transition-all py-2.5 border-0">
                        💾 Create Class
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modals Section (outside of any styled/glassmorphic containers to prevent z-index/backdrop issues) -->
<% if (classes && classes.length > 0) { %>
    <% for (let classItem of classes) { %>
        <!-- Edit Class Modal -->
        <div class="modal fade" id="editClassModal-<%= classItem._id %>" tabindex="-1" aria-labelledby="editClassModalLabel-<%= classItem._id %>" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title fw-bold text-dark" id="editClassModalLabel-<%= classItem._id %>">Update Class Assignment</h5>
                        <button type="button" class="btn-close" data-bs-close="modal" aria-label="Close"></button>
                    </div>
                    <form action="/classes/<%= classItem._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
                        <div class="modal-body py-3">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Class Name</label>
                                <select class="form-select rounded-3" name="class[className]" required>
                                    <option value="5th" <%= classItem.className === '5th' ? 'selected' : '' %>>5th</option>
                                    <option value="6th" <%= classItem.className === '6th' ? 'selected' : '' %>>6th</option>
                                    <option value="7th" <%= classItem.className === '7th' ? 'selected' : '' %>>7th</option>
                                    <option value="8th" <%= classItem.className === '8th' ? 'selected' : '' %>>8th</option>
                                    <option value="9th" <%= classItem.className === '9th' ? 'selected' : '' %>>9th</option>
                                    <option value="10th" <%= classItem.className === '10th' ? 'selected' : '' %>>10th</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Assign Teacher</label>
                                <select class="form-select rounded-3" name="class[assignedTeacher]">
                                    <option value="">No Teacher Assigned</option>
                                    <% for (let teacher of teachers) { %>
                                        <option value="<%= teacher._id %>" <%= classItem.assignedTeacher && String(classItem.assignedTeacher._id) === String(teacher._id) ? 'selected' : '' %>><%= teacher.name %></option>
                                    <% } %>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0">
                            <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-close="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold btn-gradient-blue border-0">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% } %>
<% } %>

<script>
    // Bootstrap validation script
    (() => {
      'use strict'
      const forms = document.querySelectorAll('.needs-validation')
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          }
          form.classList.add('was-validated')
        }, false)
      })
    })()
</script>
