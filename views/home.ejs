<% layout('includes/boilerplate') -%>

<div class="container">
    <div class="row justify-content-center align-items-center">
        <div class="col-12 col-md-10 col-lg-8 text-center">
            <!-- Hero Container Card -->
            <div class="hero-card p-5 rounded-5 shadow-lg border border-light border-opacity-10 bg-white-glass">
                <div class="hero-icon mb-4">
                    <img src="/images/logo.png" alt="Shri Ganesh Classes Logo" width="120" height="120" class="rounded-circle shadow border border-warning border-3" style="object-fit: cover; background-color: #ffffff;">
                </div>
                
                <h1 class="display-3 fw-extrabold text-gradient-purple-blue mb-2">
                    Shri Ganesh Classes
                </h1>
                
                <p class="fs-4 text-muted mb-5 font-weight-light">
                    Attendance Management System
                </p>
                
                <!-- CTA Action Buttons -->
                <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-4">
                    <% if (isAdmin) { %>
                        <a href="/admin/dashboard" class="btn btn-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow-lg transition-all text-uppercase tracking-wide w-100 w-sm-auto btn-gradient-blue">
                            🛡️ Go to Dashboard
                        </a>
                    <% } else { %>
                        <a href="/admin/login" class="btn btn-outline-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow-sm transition-all text-uppercase tracking-wide w-100 w-sm-auto">
                            <span class="me-2">🔑</span> Admin Login
                        </a>
                        
                        <a href="#" class="btn btn-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow-lg transition-all text-uppercase tracking-wide w-100 w-sm-auto btn-gradient-blue">
                            <span class="me-2">👨‍🏫</span> Teacher Login
                        </a>
                    <% } %>
                </div>
            </div>
            
            <!-- Dynamic Micro-features for Richer UI Aesthetics -->
            <div class="row mt-5 justify-content-center text-start g-4">
                <div class="col-12 col-sm-4">
                    <div class="card border-0 bg-transparent">
                        <div class="card-body p-0 text-center text-sm-start">
                            <h5 class="fw-bold mb-1 text-dark">⚡ Fast Tracking</h5>
                            <p class="small text-muted mb-0">Record and monitor attendance in real time with a single tap.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="card border-0 bg-transparent">
                        <div class="card-body p-0 text-center text-sm-start">
                            <h5 class="fw-bold mb-1 text-dark">🔒 Secure Access</h5>
                            <p class="small text-muted mb-0">Role-based secure portal separation for Admins and Teachers.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="card border-0 bg-transparent">
                        <div class="card-body p-0 text-center text-sm-start">
                            <h5 class="fw-bold mb-1 text-dark">📊 Insights</h5>
                            <p class="small text-muted mb-0">Generate detailed class attendance records and summaries easily.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
