<% layout('includes/boilerplate') -%>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <!-- Back Button -->
            <a href="/teachers" class="btn btn-link text-decoration-none text-muted mb-4 p-0 fw-semibold d-inline-flex align-items-center gap-1">
                <span>⬅️</span> Back to Directory
            </a>
            
            <!-- Teacher Detail Card -->
            <div class="card border-0 rounded-4 shadow-lg bg-white-glass overflow-hidden hero-card">
                <!-- Header Accent with Navy Gradient -->
                <div class="bg-gradient-nav p-5 text-center text-white position-relative">
                    <div class="avatar-placeholder bg-white text-dark rounded-circle mx-auto d-flex align-items-center justify-content-center shadow mb-3" style="width: 80px; height: 80px; font-size: 2.25rem; font-weight: 700;">
                        <%= teacher.name.charAt(0).toUpperCase() %>
                    </div>
                    <h2 class="fw-bold mb-1"><%= teacher.name %></h2>
                    <span class="badge bg-white text-dark rounded-pill px-3 py-1.5 fw-semibold small shadow-sm">Teacher Staff</span>
                </div>
                
                <!-- Card Body -->
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-12 text-center mb-2">
                            <span class="d-block small text-muted text-uppercase tracking-wider fw-medium mb-1">Class Assigned</span>
                            <% if (teacher.assignedClass) { %>
                                <h3 class="fw-bold text-success m-0">
                                    <span class="me-1">🏫</span><%= teacher.assignedClass.className %> Class
                                </h3>
                            <% } else { %>
                                <h4 class="fw-bold text-muted m-0">
                                    <span class="me-1">⚠️</span>No Assigned Class
                                </h4>
                            <% } %>
                        </div>
                        
                        <div class="col-12 border-top pt-4">
                            <h5 class="fw-bold text-dark mb-3">Contact Details</h5>
                            
                            <div class="d-flex flex-column gap-3">
                                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 transition-all">
                                    <span class="fs-4">📧</span>
                                    <div>
                                        <span class="d-block small text-muted">Email Address</span>
                                        <a href="mailto:<%= teacher.email %>" class="text-decoration-none fw-semibold text-dark">
                                            <%= teacher.email %>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 transition-all">
                                    <span class="fs-4">📞</span>
                                    <div>
                                        <span class="d-block small text-muted">Mobile Number</span>
                                        <a href="tel:<%= teacher.mobile %>" class="text-decoration-none fw-semibold text-primary">
                                            <%= teacher.mobile %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Actions Footer -->
                <div class="card-footer bg-light border-0 p-4 d-flex justify-content-between gap-3">
                    <a href="/teachers/<%= teacher._id %>/edit" class="btn btn-outline-primary px-4 py-2.5 rounded-pill fw-bold w-100 transition-all text-center">
                        ✏️ Edit Details
                    </a>
                    
                    <form action="/teachers/<%= teacher._id %>?_method=DELETE" method="POST" class="w-100" onsubmit="return confirm('Are you sure you want to delete this teacher?');">
                        <button type="submit" class="btn btn-outline-danger px-4 py-2.5 rounded-pill fw-bold w-100 transition-all">
                            🗑️ Delete Profile
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
