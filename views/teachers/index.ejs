<% layout('includes/boilerplate') -%>

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold text-gradient-purple-blue mb-0">Teachers Directory</h1>
            <p class="text-muted mb-0">Manage teaching staff and class assignments</p>
        </div>
        <a href="/teachers/new" class="btn btn-primary px-4 py-2.5 rounded-pill fw-bold btn-gradient-blue shadow transition-all">
            <span class="me-1">➕</span> Add New Teacher
        </a>
    </div>

    <!-- Table Container Card with Glassmorphism -->
    <div class="card border-0 rounded-4 shadow-sm bg-white-glass overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary border-bottom">
                        <tr>
                            <th class="ps-4 py-3">Teacher Name</th>
                            <th class="py-3">Username</th>
                            <th class="py-3">Mobile No</th>
                            <th class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (teachers && teachers.length > 0) { %>
                            <% for (let teacher of teachers) { %>
                                <tr class="transition-all">
                                    <td class="ps-4 fw-semibold text-dark"><%= teacher.name %></td>
                                    <td class="text-secondary"><%= teacher.username %></td>
                                    <td>
                                        <a href="tel:<%= teacher.mobile %>" class="text-decoration-none text-muted small fw-medium">
                                            📞 <%= teacher.mobile %>
                                        </a>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="/teachers/<%= teacher._id %>" class="btn btn-sm btn-outline-primary px-3 rounded-pill transition-all fw-semibold">
                                                👁️ View
                                            </a>
                                            <a href="/teachers/<%= teacher._id %>/edit" class="btn btn-sm btn-outline-secondary px-3 rounded-pill transition-all fw-semibold">
                                                ✏️ Edit
                                            </a>
                                            <form action="/teachers/<%= teacher._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this teacher?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded-pill transition-all fw-semibold">
                                                    🗑️ Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <span class="fs-1 d-block mb-3">📁</span>
                                    <span class="fw-semibold">No teachers registered yet.</span>
                                    <a href="/teachers/new" class="d-block mt-2 text-primary fw-bold text-decoration-none small">Add the first teacher now</a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
